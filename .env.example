DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# PKULAW MCP (keep the real access token only in .env)
PKULAW_MCP_ENABLED=1
PKULAW_ACCESS_TOKEN=
PKULAW_TIMEOUT=35
PKULAW_MIN_INTERVAL_SECONDS=1.2

# PostgreSQL example: postgresql+psycopg://compliance:password@127.0.0.1:5432/compliance_db
DATABASE_URL=
